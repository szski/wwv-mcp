# Base URL of the WorldWideView instance (no trailing slash).
# Local self-host: https://your-wwv-host.example   (or whatever you've routed it to via Caddy/Traefik/etc.)
# Production cloud: https://app.worldwideview.dev
WWV_BASE_URL=https://your-wwv-host.example

# Base URL of the WorldWideView data engine (no trailing slash).
# Local self-host: http://localhost:5001
# Cloud: https://dataengine.worldwideview.dev
WWV_ENGINE_URL=http://localhost:5001

# Auth — three options, in priority order:
#   1. WWV_USERNAME + WWV_PASSWORD: server logs in automatically at startup
#      and re-uses the session for every subsequent write/auth tool.
#   2. WWV_SESSION_TOKEN: explicit Auth.js session cookie value
#      (paste from browser DevTools → Application → Cookies → __Secure-authjs.session-token).
#   3. None: read-only camera + engine queries still work; write tools error.
# WWV_USERNAME=
# WWV_PASSWORD=
# WWV_SESSION_TOKEN=
